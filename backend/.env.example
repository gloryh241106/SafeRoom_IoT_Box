PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/safebox
JWT_SECRET=replace-with-a-long-random-secret
DEVICE_ID=safebox-01

# Keep true for local development without ESP32/EMQX. Set false for real hardware.
MOCK_HARDWARE=true
MQTT_BROKER_URL=mqtts://your-emqx-host:8883
MQTT_USERNAME=replace-me
MQTT_PASSWORD=replace-me
MQTT_CLIENT_ID=safebox_backend
MQTT_TLS_REJECT_UNAUTHORIZED=true
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_RECONNECT_PERIOD_MS=2000

# Email remains disabled until valid SMTP credentials are configured.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM=SafeRoom IoT Box <replace-me@example.com>
# Optional fallback only while the database has no user accounts.
ALERT_RECIPIENT_EMAIL=
SMTP_VERIFY_ON_STARTUP=false

ANOMALY_DEDUPE_WINDOW_MS=60000
